@inject NavigationManager NavigationManager
@inject MySoundboard.Services.IndexedDbStorageService StorageService
@using MySoundboard.Models
@using MySoundboard.Pages
@using MySoundboard.Components

<style>
    .card {
    background-color: var(--card-bg);
    border-radius: var(--radius);
    padding: 22px 24px;
    padding-bottom: 5px;
    border: 1px solid var(--border);
    cursor: pointer;
    box-shadow: var(--shadow-xs);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-sm);
    border-color: var(--primary);
    }

    .card-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    background-color: var(--primary-soft);
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 12px;
    letter-spacing: 0.04em;
    width: fit-content;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    .card h3 {
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
    }

    .card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.45;
    }

    .card .pin-icon {
    visibility: hidden;
    position: absolute;
    top: calc(0% + 10px);
    right: calc(0% + 10px);
    fill: lightgray;
    transition: transform 0.1s ease;
    }

    .card:hover .pin-icon {
    visibility: visible;
    }

    .pin-icon:hover {
    fill: gray;
    transform: scale(1.2);
    }
</style>

<div class="card" tabindex="0" @onclick="PlaySound">
    

    <span class="card-badge">@badge</span>
    <h3>@title</h3>
    <p class="text-danger">@_errorMessage</p>
</div>

@code 
{
    public static string ActivePage { get; set; }
    public static bool SkipNextReset { get; set; }

    [Parameter] public string badge { get; set; }
    [Parameter] public string title { get; set; }
    [Parameter] public string href { get; set; }
    [Parameter] public string description { get; set; }
    [Parameter] public SoundModel Sound { get; set; }




    private bool _loading = true;
    private string? _errorMessage;

    private async Task PlaySound()
    {
        _errorMessage = null;
        if (string.IsNullOrEmpty(Sound?.AudioKey))
        {
            _errorMessage = "Keine Audiodatei hinterlegt.";
            return;
        }

        try
        {
            if (!await StorageService.PlayAudioAsync(Sound.AudioKey))
            {
                _errorMessage = "Audiodatei nicht gefunden.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }



}
